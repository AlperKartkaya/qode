# Open Gateway. Real identifiers/secrets belong only in the ignored root .env
# or the VM secret store; never commit them.
OPENGW_API_ROOT="https://opengateway.turkcell.com.tr"
OPENGW_CLIENT_ID="<SET_VIA_SECURE_CHANNEL>"
OPENGW_CLIENT_SECRET="<SET_IN_VM_SECRET_STORE>"
OPENGW_REDIRECT_URI="http://<REGISTERED_PUBLIC_HOST>:<PORT>/api/auth/callback"
OPENGW_SCOPES="openid dpv:RequestedServiceProvision#quality-on-demand:sessions:create dpv:FraudPreventionAndDetection#number-verification:verify"
OPENGW_QOS_PROFILE="teknofest2026"
MOBILE_AUTH_RETURN_URI="qode://auth/callback"
OPENGW_TIMEOUT_SECONDS="15"

# Final job/container contract. Freeze must replace this example with an
# immutable repository digest, not latest or a mutable candidate tag.
FINAL_AI_IMAGE="teknofest-2026/qode-final:<frozen-tag>@sha256:<repo-digest>"
FINAL_JOB_ROOT="/var/lib/qode/jobs"
USE_GPU="True"
CONTAINER_TIMEOUT_SECONDS="570"
MAX_UPLOAD_BYTES="1500000000"
MAX_JOB_DISK_BYTES="10000000000"
JOB_TTL_SECONDS="86400"
AUTH_STATE_TTL_SECONDS="300"
SESSION_TTL_SECONDS="3600"
ALLOWED_ORIGINS="http://<ANDROID_REACHABLE_BACKEND_HOST>"
